@import "tailwindcss";
:root{--navy:#071c3f;--royal:#103f85;--gold:#e5bd5a;--ivory:#faf7f0}*{box-sizing:border-box}html,body{margin:0}body{background:var(--ivory);color:var(--navy);font-family:Arial,Helvetica,sans-serif}button,a{-webkit-tap-highlight-color:transparent}.site-header{position:relative;z-index:20;background:var(--navy);color:#fff}.announcement{height:29px;background:#04122b;color:var(--gold);overflow:hidden;display:flex;align-items:center;border-bottom:1px solid #e5bd5a30}.announcement-track{white-space:nowrap;min-width:max-content;font-size:9px;letter-spacing:2.1px;animation:marquee 42s linear infinite}@keyframes marquee{to{transform:translateX(-50%)}}.header-shell{max-width:1480px;margin:auto;min-height:88px;padding:0 42px;display:flex;align-items:center;justify-content:space-between;gap:28px;border-bottom:1px solid #e5bd5a55}.brand{display:flex;align-items:center;gap:12px;min-width:250px;text-decoration:none;color:#fff}.brand img{object-fit:contain;width:64px;height:64px}.brand-type{display:flex;flex-direction:column;gap:6px}.brand-type strong{font-family:Georgia,serif;font-size:17px;letter-spacing:1.5px;font-weight:500}.brand-type small{font-size:8px;color:var(--gold);letter-spacing:2.4px}.desktop-nav{display:flex;align-items:center;gap:25px}.nav-link{font-size:10px;font-weight:600;letter-spacing:1.25px;white-space:nowrap;text-decoration:none;color:#f6f3ed;background:none;border:0;cursor:pointer;padding:34px 0;transition:color .2s}.nav-link:hover,.header-actions a:hover,.header-actions button:hover{color:var(--gold)}.chevron{font-size:16px;margin-left:4px}.shop-wrap{position:relative}.shop-dropdown{position:absolute;top:100%;left:-25px;background:#fff;color:var(--navy);border:1px solid #e5bd5a80;min-width:210px;box-shadow:0 20px 40px #0003;padding:12px;display:flex;flex-direction:column}.shop-dropdown a{padding:11px 14px;font-size:12px;text-decoration:none;color:var(--navy)}.shop-dropdown a:hover{background:#f6f0e3}.header-actions{display:flex;align-items:center;gap:18px}.header-actions a,.header-actions button{color:#fff;background:none;border:0;display:inline-flex;align-items:center;justify-content:center;position:relative;cursor:pointer;text-decoration:none;padding:2px}.cart-count{position:absolute;top:-8px;right:-9px;font-size:9px;color:var(--gold)}.mobile-menu-toggle{display:none!important}.search-bar{display:flex;gap:12px;max-width:720px;margin:auto;padding:14px 25px}.search-bar input{flex:1;min-width:0;padding:12px 14px;border:1px solid #d8cba9;background:#fff;color:#071c3f}.search-bar button{background:var(--gold);color:var(--navy);padding:0 20px;border:0;font-size:11px;font-weight:bold}.blank-stage{min-height:calc(100vh - 117px);background:var(--ivory);display:flex;align-items:flex-start;justify-content:center}.stage-mark{margin-top:65px;width:100px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}.mobile-nav{display:none}@media(max-width:1150px){.header-shell{padding:0 25px}.brand{min-width:220px}.desktop-nav{gap:14px}.nav-link{font-size:9px}.header-actions{gap:12px}}@media(max-width:950px){.header-shell{min-height:78px;padding:0 20px}.brand{min-width:0}.brand img{width:56px;height:56px}.brand-type strong{font-size:15px}.desktop-nav{display:none}.mobile-menu-toggle{display:inline-flex!important}.mobile-nav{display:flex;flex-direction:column;padding:10px 24px 25px;border-top:1px solid #e5bd5a44}.mobile-nav>a{padding:14px 4px;border-bottom:1px solid #ffffff18;color:#fff;text-decoration:none;font-size:13px}.mobile-categories{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding-top:18px}.mobile-categories a{color:var(--gold);font-size:12px;text-decoration:none}}@media(max-width:500px){.brand-type strong{font-size:12px;letter-spacing:.6px}.brand-type small{font-size:7px;letter-spacing:1.3px}.brand img{width:48px;height:48px}.header-shell{padding:0 12px;gap:8px}.header-actions{gap:11px}.header-actions svg{width:18px;height:18px}.header-actions a[aria-label="Account"]{display:none}.announcement{height:25px}.blank-stage{min-height:calc(100vh - 103px)}}@media(prefers-reduced-motion:reduce){.announcement-track{animation:none}}
