"use client";
import Image from "next/image";
import Link from "next/link";
import { useState } from "react";
const categories = ["Sarees", "Dupattas", "Lehengas", "Fabrics", "Kurtas", "Home Decor"];
const nav = [{label:"Home",href:"/"},{label:"Shop",href:"/shop"},{label:"Collections",href:"/collections"},{label:"New Arrivals",href:"/new-arrivals"},{label:"About",href:"/about"},{label:"Contact",href:"/contact"}];
function Icon({name}:{name:"search"|"user"|"heart"|"bag"|"menu"|"close"}) {
 const common={width:20,height:20,viewBox:"0 0 24 24",fill:"none",stroke:"currentColor",strokeWidth:1.65,strokeLinecap:"round" as const,strokeLinejoin:"round" as const};
 const paths={search:<><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></>,user:<><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></>,heart:<path d="M20.8 8.3c0 4.3-8.8 10-8.8 10s-8.8-5.7-8.8-10a5 5 0 0 1 8.8-3.2 5 5 0 0 1 8.8 3.2Z"/>,bag:<><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></>,menu:<><path d="M4 7h16M4 12h16M4 17h16"/></>,close:<path d="M5 5 19 19M19 5 5 19"/>};
 return <svg {...common} aria-hidden="true">{paths[name]}</svg>;
}
export default function Header(){
 const [menu,setMenu]=useState(false); const [shop,setShop]=useState(false); const [search,setSearch]=useState(false);
 return <header className="site-header">
  <div className="announcement"><div className="announcement-track">✦ THE ART OF SRIKALAHASTI KALAMKARI &nbsp; ✦ HANDCRAFTED HERITAGE &nbsp; ✦ TIMELESS INDIAN ARTISTRY &nbsp; ✦ THE ART OF SRIKALAHASTI KALAMKARI &nbsp; ✦ HANDCRAFTED HERITAGE &nbsp; ✦ TIMELESS INDIAN ARTISTRY &nbsp;</div></div>
  <div className="header-shell">
   <Link className="brand" href="/" aria-label="Srikalahasti Kalamkari home"><Image src="/srikalahasti-logo.png" width={64} height={64} alt="Srikalahasti Kalamkari emblem" priority/><span className="brand-type"><strong>SRIKALAHASTI</strong><small>K A L A M K A R I</small></span></Link>
   <nav className="desktop-nav" aria-label="Main navigation">{nav.map(item=>item.label==="Shop"?<div className="shop-wrap" key="Shop" onMouseEnter={()=>setShop(true)} onMouseLeave={()=>setShop(false)}><button className="nav-link" onClick={()=>setShop(!shop)} aria-expanded={shop} aria-haspopup="true">SHOP <span className="chevron">⌄</span></button>{shop&&<div className="shop-dropdown">{categories.map(c=><Link key={c} href={`/shop?category=${encodeURIComponent(c)}`} onClick={()=>setShop(false)}>{c}</Link>)}</div>}</div>:<Link className="nav-link" href={item.href} key={item.label}>{item.label.toUpperCase()}</Link>)}</nav>
   <div className="header-actions"><button aria-label="Search" onClick={()=>setSearch(!search)}><Icon name="search"/></button><Link href="/account" aria-label="Account"><Icon name="user"/></Link><Link href="/wishlist" aria-label="Wishlist"><Icon name="heart"/></Link><Link href="/cart" aria-label="Shopping cart"><Icon name="bag"/><span className="cart-count">0</span></Link><button className="mobile-menu-toggle" aria-label={menu?"Close menu":"Open menu"} onClick={()=>setMenu(!menu)}><Icon name={menu?"close":"menu"}/></button></div>
  </div>
  {search&&<form className="search-bar" action="/shop"><input name="q" autoFocus placeholder="Search the art of Kalamkari..." aria-label="Search products"/><button type="submit">SEARCH</button></form>}
  {menu&&<nav className="mobile-nav" aria-label="Mobile navigation">{nav.map(item=><Link href={item.href} key={item.label} onClick={()=>setMenu(false)}>{item.label}</Link>)}<div className="mobile-categories">{categories.map(c=><Link href={`/shop?category=${encodeURIComponent(c)}`} key={c} onClick={()=>setMenu(false)}>{c}</Link>)}</div></nav>}
 </header>;
}
